# Copy to image/.env and edit; every script sources image/.env if it exists. All paths may be absolute.
# Data (never committed): the labels CSV, the shared split, the media files.
AI4EYES_DATA_DIR=./data
AI4EYES_LABELS_CSV=./data/labels.csv          # one row per (exam, eye, test type, labeller); columns in README
AI4EYES_SPLIT_CSV=./data/split.csv            # patient_pid,split — the SAME file as the video repo uses
AI4EYES_IMAGES_DIR=./data/images              # <exam_id>/<file>, mirrors the S3 layout
AI4EYES_SSL_MANIFEST=./data/ssl_manifest.csv
# Weights and results
AI4EYES_CHECKPOINT_DIR=./checkpoints
AI4EYES_OUTPUT_DIR=./outputs
AI4EYES_WORK_DIR=./work                        # fast scratch: per-epoch weights, SSL checkpoint (e.g. local NVMe)
AI4EYES_VJEPA2_DIR=./third_party/vjepa2
# S3 bucket holding the exam media (read-only access is enough)
AI4EYES_S3_BUCKET=
# Python interpreter (optional)
# PY=python
